{
  "name": "Rastrata",
  "version": "1.1.1",
  "main": "index.html",
  "description": "App time tracker",
  "node-remote": "<all_urls>",
  "single-instance": true,
  "window": {
    "width": 420,
    "height": 600,
    "min_width": 340,
    "min_height": 400,
    "frame": false,
    "icon": "icon.png",
    "position": "center",
    "toolbar": false,
    "show": false
  },
  "chromium-args": "--disable-http-cache --disable-background-networking --disable-sync --disable-translate --no-pings"
}
